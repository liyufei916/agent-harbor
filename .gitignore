.DS_Store
*.swp
*.swo
.idea/
.vscode/
*.local
.env
.env.*
!.env.example
/tmp/
/_agent-harbor-probe/

# Go/Wails 生成产物；build 中的图标与 darwin/docker 配置仍可提交
/bin/
/build/bin/
# 多端脚手架生成物：易导致覆盖率报告出现大量 0.0% 噪音行
/build/android/
/build/ios/
/frontend/node_modules/
# dist 构建产物忽略，但保留可提交占位文件供 go:embed / CI 编译
/frontend/dist/**
!/frontend/dist/index.html
/frontend/bindings/
/frontend/wailsjs/
.task/
.gocache/
/actionlint
/actionlint.exe

# Python 验收脚本缓存
__pycache__/
*.pyc

# 演示工作区运行产物（保留 README；Agent 可覆盖 hello.txt）
/demos/workspace/**
!/demos/workspace/README.md
